                  "value": "<boolean>",
                  "description": "Whether to overwrite an existing file at the path."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) Directory path and filename, e.g. images/photo.png."
